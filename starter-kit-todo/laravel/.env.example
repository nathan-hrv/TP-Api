APP_NAME="Todo API"
APP_ENV=local
# Généré automatiquement au premier démarrage
APP_KEY=
# false : aucune trace dans les réponses d'erreur (même en développement)
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Mémoire partagée APCu : PHP oublie tout entre deux requêtes, APCu non (voir app/Services/TodoStore.php)
CACHE_STORE=apc

# Mots de passe des deux comptes de démonstration (à renseigner : jamais commités)
# Compte "admin" (rôle admin) et compte "user" (rôle user)
APP_ADMIN_PASSWORD=
APP_USER_PASSWORD=

# Documentation OpenAPI : régénérée à chaque affichage en développement uniquement
L5_SWAGGER_GENERATE_ALWAYS=true
